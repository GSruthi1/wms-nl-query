# Copy to .env and fill in. .env is gitignored.

# --- Database (privileged: migrations, audit writes) ---
# Host port 5433, not 5432 — avoids colliding with the LDIP project's own
# Postgres container if both are running locally. Inside docker-compose,
# app->db traffic uses the internal 5432 (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg2://wms:wms@localhost:5433/wms
DATABASE_URL_TEST=postgresql+psycopg2://wms:wms@localhost:5433/wms_test

# --- Database (read-only role: executes LLM-generated SQL) ---
# Created by alembic migration 0002; grants SELECT only, on WMS data tables,
# not audit_log. Never point this at the privileged role.
DATABASE_URL_READONLY=postgresql+psycopg2://wms_readonly:wms_readonly@localhost:5433/wms

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_ANTHROPIC=claude-sonnet-5
LLM_MODEL_OPENAI=gpt-4o

# --- Query safety ---
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_ROW_LIMIT=500

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- UI ---
# Host port 8001, not 8000 — see docker-compose.yml port-mapping note.
WMS_API_URL=http://localhost:8001
